<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Mahasiswa | E-Learning UPR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; }
        .card { border: none; border-radius: 15px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .navbar-brand { font-weight: bold; color: #198754 !important; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">🎓 E-Learning Kelompok 5</a>
            <span class="navbar-text text-success fw-bold">Login sebagai: Mahasiswa</span>
        </div>
    </nav>

    <div class="container">
        <div class="card p-4">
            <h5 class="mb-3 text-success">📂 Daftar Materi & Tugas dari Dosen</h5>
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>No</th>
                            <th>Judul Materi / Tugas</th>
                            <th>Tipe</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (materi && materi.length > 0) { %>
                            <% materi.forEach((item, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td class="fw-bold"><%= item.judul %></td>
                                    <td><span class="badge bg-info text-dark"><%= item.tipe === 'materi_belajar' ? 'Materi' : 'Tugas' %></span></td>
                                    <td>
                                        <a href="<%= item.file_dokumen %>" target="_blank" class="btn btn-sm btn-success">⬇️ Unduh File</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center text-muted">Belum ada materi dari dosen.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>