<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Learning UPR | Portal Mahasiswa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style> body { background-color: #f4f7f6; font-family: 'Segoe UI', sans-serif; } </style>
</head>
<body>

    <nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/mahasiswa"><i class="bi bi-cloud-check-fill text-primary me-2"></i>E-Learning Kelompok 5</a>
            <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-mortarboard-fill me-1"></i> Mode Mahasiswa</span>
        </div>
    </nav>

    <div class="container">
        <div class="alert alert-success shadow-sm rounded-3 mb-4 border-0" role="alert">
            <h5 class="alert-heading fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Selamat Datang, Mahasiswa!</h5>
            <p class="mb-0 small">Silakan unduh materi dari dosen di tabel kanan, dan kumpulkan tugasmu melalui form di sebelah kiri.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-journal-arrow-up text-primary me-2"></i>Kumpulkan Tugas</h5>
                        <form action="/upload-mahasiswa" method="POST" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Nama / Judul Tugas</label>
                                <input type="text" name="judul" class="form-control rounded-3" placeholder="Misal: Tyara - Tugas 1" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Pilih File Tugas</label>
                                <input type="file" name="file" class="form-control rounded-3" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 rounded-3 py-2 fw-bold shadow-sm">Kirim Tugas</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-folder-fill text-warning me-2"></i>Daftar Materi & Tugas Terkumpul</h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>No</th>
                                        <th>Judul File</th>
                                        <th>Kategori</th>
                                        <th class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof materi !== 'undefined' && materi.length > 0) { %>
                                        <% materi.forEach((item, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td class="fw-semibold"><%= item.judul || item.nama %></td>
                                                <td>
                                                    <% if (item.kategori === 'Materi Dosen' || item.kategori === 'Materi') { %>
                                                        <span class="badge bg-info text-dark">Materi Dosen</span>
                                                    <% } else if (item.kategori === 'Soal Tugas') { %>
                                                        <span class="badge bg-danger">Soal Tugas</span>
                                                    <% } else { %>
                                                        <span class="badge bg-success">Tugas Terkumpul</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group gap-1">
                                                        <a href="/download/<%= item.id %>" class="btn btn-sm btn-outline-primary" target="_blank">
                                                            <i class="bi bi-download"></i>
                                                        </a>
                                                        <form action="/delete/<%= item.id %>" method="POST" class="d-inline hapus-form">
                                                            <button type="button" class="btn btn-sm btn-outline-danger btn-hapus">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">Belum ada file di server.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.btn-hapus').forEach(button => {
            button.addEventListener('click', function() {
                const form = this.closest('form');
                Swal.fire({
                    title: 'Yakin hapus tugas?',
                    text: "File akan dihapus permanen dari sistem!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Ya, Hapus!',
                    cancelButtonText: 'Batal'
                }).then((result) => {
                    if (result.isConfirmed) { form.submit(); }
                });
            });
        });
    </script>
</body>
</html>
