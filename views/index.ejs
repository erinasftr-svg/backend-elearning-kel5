<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Learning UPR | Portal Dosen</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style> body { background-color: #f4f7f6; font-family: 'Segoe UI', sans-serif; } </style>
</head>
<body>

    <nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/"><i class="bi bi-cloud-check-fill text-primary me-2"></i>E-Learning Kelompok 5</a>
            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-person-workspace me-1"></i> Mode Dosen</span>
        </div>
    </nav>

    <div class="container">
        <div class="row g-4">
            
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-cloud-arrow-up-fill text-danger me-2"></i>Unggah Materi/Soal</h5>
                        <form action="/upload" method="POST" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Judul Materi / Tugas</label>
                                <input type="text" name="judul" class="form-control rounded-3" placeholder="Masukkan judul..." required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Kategori</label>
                                <select name="kategori" class="form-select rounded-3">
                                    <option value="Materi Dosen">Materi Dosen</option>
                                    <option value="Soal Tugas">Soal Tugas</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Pilih File</label>
                                <input type="file" name="file" class="form-control rounded-3" required>
                            </div>
                            <button type="submit" class="btn btn-danger w-100 rounded-3 py-2 fw-bold shadow-sm">Simpan ke AWS S3</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-hdd-network-fill text-success me-2"></i>Data Server (RDS MySQL)</h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>No</th>
                                        <th>Judul File</th>
                                        <th>Kategori</th>
                                        <th class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof materi !== 'undefined' && materi.length > 0) { %>
                                        <% materi.forEach((item, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td class="fw-semibold"><%= item.judul || item.nama %></td>
                                                <td>
                                                    <span class="badge bg-secondary"><%= item.kategori || item.jenis || 'Materi' %></span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group gap-1">
                                                        <a href="<%= item.file_url || item.url %>" class="btn btn-sm btn-outline-primary" target="_blank"><i class="bi bi-download"></i></a>
                                                        <form action="/delete/<%= item.id %>" method="POST" class="d-inline hapus-form">
                                                            <button type="button" class="btn btn-sm btn-outline-danger btn-hapus"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">Belum ada materi di server.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        document.querySelectorAll('.btn-hapus').forEach(button => {
            button.addEventListener('click', function() {
                const form = this.closest('form');
                Swal.fire({
                    title: 'Yakin hapus materi?',
                    text: "File akan dihapus permanen dari AWS S3!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Ya, Hapus!',
                    cancelButtonText: 'Batal'
                }).then((result) => {
                    if (result.isConfirmed) { form.submit(); }
                });
            });
        });
    </script>
</body>
</html>