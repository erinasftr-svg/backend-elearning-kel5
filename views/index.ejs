<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Dosen | E-Learning UPR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { background-color: #f4f7f6; }
        .card { border: none; border-radius: 15px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .navbar-brand { font-weight: bold; color: #0d6efd !important; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand" href="#">🎓 E-Learning Kelompok 5</a>
            <span class="navbar-text text-primary fw-bold">Login sebagai: Dosen</span>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card p-4">
                    <h5 class="mb-3 text-primary">📤 Unggah Materi Baru</h5>
                    <form action="/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Judul Materi / Tugas</label>
                            <input type="text" name="judul" class="form-control" placeholder="Masukkan judul..." required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tipe Dokumen</label>
                            <select name="tipe" class="form-select" required>
                                <option value="materi_belajar">📚 Bahan Materi Belajar</option>
                                <option value="tugas">📝 Tugas Mahasiswa</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Pilih File (PDF/Word/PPT)</label>
                            <input type="file" name="file" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold" onclick="showLoading()">Simpan & Unggah ke S3</button>
                    </form>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card p-4">
                    <h5 class="mb-3 text-success">📂 Daftar Materi Terunggah</h5>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Judul Materi</th>
                                    <th>Tipe</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (materi && materi.length > 0) { %>
                                    <% materi.forEach((item, index) => { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td class="fw-bold"><%= item.judul %></td>
                                            <td><span class="badge bg-info text-dark"><%= item.tipe === 'materi_belajar' ? 'Materi' : 'Tugas' %></span></td>
                                            <td>
                                                <a href="<%= item.file_dokumen %>" target="_blank" class="btn btn-sm btn-outline-success">Lihat File</a>
                                                
                                                <a href="/delete/<%= item.id %>" class="btn btn-sm btn-outline-danger ms-1" onclick="return confirm('Apakah kamu yakin ingin menghapus materi ini?')">Hapus</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Belum ada materi yang diunggah.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showLoading() {
            const form = document.getElementById('uploadForm');
            if(form.checkValidity()) {
                Swal.fire({
                    title: 'Mengunggah ke AWS S3...',
                    html: 'Mohon tunggu sebentar ya.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading()
                    }
                });
            }
        }

        const urlParams = new URLSearchParams(window.location.search);
        
        // Notifikasi Sukses Upload
        if(urlParams.get('status') === 'success') {
            Swal.fire({
                icon: 'success',
                title: 'BUM! Berhasil!',
                text: 'Materi sukses tersimpan di AWS RDS dan S3!',
                confirmButtonColor: '#0d6efd'
            }).then(() => {
                window.history.replaceState(null, null, window.location.pathname);
            });
        }

        // Notifikasi Sukses Hapus
        if(urlParams.get('status') === 'deleted') {
            Swal.fire({
                icon: 'success',
                title: 'Terhapus!',
                text: 'Data materi berhasil dihapus dari sistem.',
                confirmButtonColor: '#dc3545'
            }).then(() => {
                window.history.replaceState(null, null, window.location.pathname);
            });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>